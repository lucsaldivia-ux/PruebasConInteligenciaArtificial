
# --- GitHub Models API (RA1: LLMs) ---
OPENAI_BASE_URL="https://models.inference.ai.azure.com"
GITHUB_BASE_URL="https://models.inference.ai.azure.com"
OPENAI_EMBEDDINGS_URL="https://models.github.ai/inference"
GITHUB_TOKEN=""

# --- LangSmith (RA3: Observabilidad y Trazabilidad) ---
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="manantial-chatbot"

# --- Base de Datos (RA2: Persistencia de Memoria) ---
DB_PATH="./data/manantial.db"

# --- CrewAI Configuration (RA2: Agentes Inteligentes) ---
CREW_VERBOSE="true"
CREW_LOG_LEVEL="INFO"

# --- Rate Limiting y Seguridad (RA3: Seguridad) ---
MAX_REQUESTS_PER_MINUTE=10
MAX_INPUT_LENGTH=500
