
# --- GitHub Models API (RA1: LLMs) ---
OPENAI_BASE_URL="https://models.inference.ai.azure.com"
GITHUB_BASE_URL="https://models.inference.ai.azure.com"
OPENAI_EMBEDDINGS_URL="https://models.github.ai/inference"
GITHUB_TOKEN=""

# --- LangSmith (RA3: Observabilidad y Trazabilidad) ---
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="manantial-chatbot"

# --- Base de Datos (RA2: Persistencia de Memoria) ---
DB_PATH="./data/manantial.db"
USE_DYNAMODB="false"  # true para AWS Lambda, false para desarrollo local
DYNAMODB_TABLE="manantial-sessions"
DYNAMODB_ORDERS_TABLE="manantial-orders"

# --- CrewAI Configuration (RA2: Agentes Inteligentes) ---
CREW_VERBOSE="false"
CREW_LOG_LEVEL="INFO"

# --- Rate Limiting y Seguridad (RA3: Seguridad) ---
MAX_REQUESTS_PER_MINUTE=10
MAX_INPUT_LENGTH=500

# --- API Web (FastAPI + Streamlit) ---
API_BASE_URL="http://localhost:8000"  # Cambiar a Lambda URL en producción
STREAMLIT_PORT=8501
STREAMLIT_PUBLIC_URL=""  # Para deployment en AWS

# --- AWS Configuration ---
AWS_REGION="us-east-1"  # Cambiar según tu región en Academy
AWS_PROFILE="default"   # Perfil AWS
